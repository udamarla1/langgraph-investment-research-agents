import stateData
import common


def create_research_agent(company: str):
    def research_node(state: stateData) -> dict:
        """
        Research node that performs research on a given company.

        Args:
            state (stateData): The current state of the investment analysis.

        Returns:
            dict: A dictionary containing the research results.
        """
        query = f"Research {company} for investment analysis."
        data = common.create_search_tool().invoke(query)

        research_prompt = f"""You are an investment analyst. Conduct thorough research on the company: {company}.
        Provide specific numbers, dates, and sources. Focus on financial performance, market position, and
        any recent news or developments for {company} and {data}. Be concise but thorough."""

        research_results = common.create_llm().invoke([
            stateData.HumanMessage(content=research_prompt)
        ])
        
        # Update the state with the research results
        if company.lower() == "tesla":
            state['research_tesla'] = research_results['output']
        elif company.lower() == "nvidia":
            state['research_nvidia'] = research_results['output']
        
        return {
            "output": research_results['output'],
            "time": research_results['time'],
            "output_length": research_results['output_length'],
            "approach": research_results['approach']
        }

company_agents = {
    "TESLA": create_research_agent("TESLA"),
    "NVIDIA": create_research_agent("NVIDIA"),
}

print(f"Research agents created for TESLA and NVIDIA. {list(company_agents.keys())}")